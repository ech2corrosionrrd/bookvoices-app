<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 і нижче.

  Зашифровані секрети не бекапимо: на іншому пристрої ключ із Keystore недоступний
  і файл усе одно не розшифрується.

  Скопійоване аудіо теж ні. Хмарний бекап Android обмежений ~25 МБ на застосунок,
  а одна аудіокнига в filesDir/imports буває на гігабайти: разом із нею мовчки
  провалився б увесь бекап, тобто й полиця, і прогрес, і закладки.

  Саму базу лишаємо: адреси файлів на новому пристрої будуть недійсні, але книга
  з прогресом і закладками відновлюється, а теку показує перепривʼязка (див. RelinkMatcher).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bookvoices_secrets_v2.xml" />
    <exclude domain="file" path="imports/" />
    <exclude domain="file" path="demo/" />
</full-backup-content>
