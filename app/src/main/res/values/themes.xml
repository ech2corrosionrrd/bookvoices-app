<?xml version="1.0" encoding="utf-8"?>
<!--
  Батько — AppCompat: MainActivity успадковує AppCompatActivity заради перемикача
  мови на API < 33 (AppCompatDelegate застосовує локаль лише до AppCompat-екранів).
-->
<resources>
    <style name="Theme.BookVoices" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/night_bg</item>
        <item name="colorPrimary">@color/filament</item>
    </style>

    <!--
      Вікно малюється до першого кадру Compose, тому колір підкладки має збігатися
      з обраною темою — інакше «паперова» тема стартує з темного блимання.
      MainActivity вибирає стиль синхронно з дзеркала налаштувань (UserPrefs.themeModeBlocking).
    -->
    <style name="Theme.BookVoices.Paper">
        <item name="android:windowBackground">@color/paper_bg</item>
    </style>

    <!--
      OLED теж потребує власного стилю: типовий night_bg — темно-синій, а тема
      малює чистий чорний, тож без цього рядка запуск починався з видимого
      посвітлілого кадру.
    -->
    <style name="Theme.BookVoices.Oled">
        <item name="android:windowBackground">@color/oled_bg</item>
    </style>
</resources>
